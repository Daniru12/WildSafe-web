# Example Vite environment variables for WildSafe-web
# Copy this file to .env (or .env.local) and update values for your environment.

# Backend base URL — include /api if your backend serves at /api
# Examples:
# - Local: http://localhost:5000/api
# - Production: https://api.wildsafe.daniruranathunga.live/api
VITE_API_BASE_URL=https://api.wildsafe.daniruranathunga.live/api

# Do NOT commit real secrets. Keep credentials and tokens out of source control.
